# Sample Caddy reverse proxy for Upasthiti on the client's own server (M6, spec 7.5).
# It does three jobs: serves the built website, passes /api to the backend, and sets the security
# headers that Vercel sets today (frontend/vercel.json). Keep the header lists in sync with that
# file; a test (backend/tests/test_m6_headers.py) compares them.
#
# Variables (set them in the environment of Caddy; the defaults suit a local check):
#   SITE_ADDRESS      the address people use. A domain name (upasthiti.company.example) makes Caddy
#                     get a certificate by itself. http://localhost:8080 is for local checks only.
#   BACKEND_UPSTREAM  where the backend listens, default 127.0.0.1:8000
#   FRONTEND_DIR      the folder made by `npm run build` (frontend/dist), default /srv/upasthiti
#
# Backend settings for this layout: ONE proxy in front, so TRUSTED_PROXY_HOPS=1 (or set
# CLIENT_IP_HEADER=X-Real-IP, which this file overwrites with the connecting address).
# Two proxies in a row: TRUSTED_PROXY_HOPS=2. No proxy: 0 (and keep the backend port closed to the
# outside). The runbook lists every layout.
# After every change: log in once and compare the IP in the audit log with your computer's address.

{$SITE_ADDRESS:http://localhost:8080} {
	encode zstd gzip

	# On every response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		-Server
	}

	# The gate screen: strict CSP, camera and location only for us.
	@gate path /attendance /attendance/*
	header @gate {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Referrer-Policy "no-referrer"
	}

	# The employee phone pages: the same CSP, and passkeys allowed.
	@phone path /phone /phone/*
	header @phone {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(self), geolocation=(self), publickey-credentials-get=(self), publickey-credentials-create=(self), microphone=()"
		Referrer-Policy "no-referrer"
	}

	# The gate's service worker may control /attendance only; it must never be cached for long.
	@worker path /sw.js
	header @worker {
		Cache-Control "no-cache"
		Service-Worker-Allowed "/attendance"
	}
	@version path /version.json
	header @version Cache-Control "no-cache"

	# The API: never kept by a browser or a proxy (personal data, one-time codes).
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy {$BACKEND_UPSTREAM:127.0.0.1:8000} {
			# OVERWRITE what the caller sent, never append to it: the caller's own entries
			# would otherwise decide which IP the backend limits and logs.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else is the website (one page app: unknown paths show index.html).
	handle {
		root * {$FRONTEND_DIR:/srv/upasthiti}
		try_files {path} /index.html
		file_server
	}
}

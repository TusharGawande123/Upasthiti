# Upasthiti production settings (own server). This file has NAMES and comments only, no values.
# install.ps1 / install.sh copies it to ".env" in this folder and fills the secrets for you.
# ".env" is secret and git-ignored: NEVER commit it, never send it by chat or email.
# Keep a copy of every KEY in the company password manager (see docs/guides/install-guide.md).

# --- The address people use ---------------------------------------------------------------
# The name only, no https:// and no port. Example shape: your-name.duckdns.org
SITE_ADDRESS=
# The full address with https://, no slash at the end. If HTTPS_PORT is not 443, add it here:
# https://your-name.duckdns.org:8443
APP_PUBLIC_ORIGIN=
# The port people use outside the computer. 443 normally; 8443 if 443 is already in use.
HTTPS_PORT=443
# Free DuckDNS token (from duckdns.org, shown after sign-in). Only Caddy gets it.
DUCKDNS_TOKEN=
# Use Caddyfile.own-certificate instead when the client's IT supplies the certificate files.
CADDYFILE=Caddyfile.duckdns

# --- Database -----------------------------------------------------------------------------
# Letters and digits only (it sits inside an address). The install script makes one.
POSTGRES_PASSWORD=

# --- Secrets (the install script makes them; keep copies in the password manager) --------
# Protects pairing codes. Lost = people pair again, nothing else.
APP_SECRET_KEY=
# Signs the QR cards. LOST = EVERY PRINTED CARD MUST BE ISSUED AGAIN.
QR_SIGNING_KEY=
QR_SIGNING_KEY_ID=A
# Encrypts punch photos. LOST = STORED PHOTOS CAN NO LONGER BE OPENED.
SNAPSHOT_ENCRYPTION_KEY=
# Encrypts face records. LOST = EVERY EMPLOYEE MUST BE ENROLLED AGAIN.
FACE_TEMPLATE_KEY=
# Opens punches saved on attendance devices while offline. LOST = waiting punches unreadable.
OFFLINE_EVIDENCE_KEY=
OFFLINE_EVIDENCE_KEY_ID=A
# Encrypts backup files. LOST = EVERY BACKUP IS UNREADABLE.
BACKUP_KEY=
BACKUP_KEY_ID=A

# --- Folders and options ------------------------------------------------------------------
# A folder of this computer where backup files are written (not the same disk as the data if you
# can avoid it). Windows example: D:/upasthiti-backups   Linux example: /backups/upasthiti
BACKUP_DIR=./backups
# Only for Caddyfile.own-certificate: folder holding fullchain.pem and privkey.pem.
CERT_DIR=./certs
# Shown on the health page. Optional.
APP_VERSION=prod
LOG_LEVEL=INFO

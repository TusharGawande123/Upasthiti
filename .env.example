# Backend settings. Copy this file to .env (git-ignored) and change values if needed.
# NEVER commit a real .env: the repository is public.
# Frontend settings live in frontend/.env.example.

# development | test | production. Production turns off the /api/docs page.
APP_ENV=development

# Shown by GET /api/v1/health. CI and the server set it to the git commit.
APP_VERSION=dev

# PostgreSQL connection. This default matches docker-compose.yml (local only).
# Supabase/Render give "postgresql://..." URLs; they work as they are.
DATABASE_URL=postgresql+psycopg://upasthiti:upasthiti@localhost:5432/upasthiti

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Backend settings. Copy this file to .env (git-ignored) and change values if needed.
# NEVER commit a real .env: the repository is public.
# Frontend settings live in frontend/.env.example.

# development | test | production. Production turns off the /api/docs page.
APP_ENV=development

# Shown by GET /api/v1/health. CI and the server set it to the git commit.
APP_VERSION=dev

# PostgreSQL connection. This default matches docker-compose.yml (local only). Use
# 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 first and is very slow.
# Supabase/Render give "postgresql://..." URLs; they work as they are.
DATABASE_URL=postgresql+psycopg://upasthiti:upasthiti@127.0.0.1:5432/upasthiti

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Secret for protecting kiosk pairing codes. At least 32 random characters. Make a new one
# for every server, e.g.:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# The value below is for local development only.
APP_SECRET_KEY=local-development-only-change-me-0123456789

# The website address browsers use. Write requests from other sites are refused.
# Required in production (e.g. https://upasthiti.vercel.app). Local default: Vite dev server.
APP_PUBLIC_ORIGIN=http://localhost:5173

# Number of proxies in front of the backend (production: Vercel + Render = measured at the
# first deploy). 0 locally. Used only for logs and rate limits.
TRUSTED_PROXY_HOPS=0

# true on Render: run database migrations when the container starts.
RUN_MIGRATIONS_ON_START=false

# Test database for `uv run pytest` (wiped on every test run; the name must end in _test).
# Same Postgres as above (docker-compose.yml); the tests create the database themselves.
TEST_DATABASE_URL=postgresql+psycopg://upasthiti:upasthiti@127.0.0.1:5432/upasthiti_test
